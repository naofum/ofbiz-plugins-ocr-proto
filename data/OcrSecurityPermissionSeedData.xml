<entity-engine-xml>

    <!-- OCR Security Permissions -->
    <SecurityPermission permissionId="OCR_ADMIN" description="OCR administration permission"/>
    <SecurityPermission permissionId="OCR_CREATE" description="Create and execute OCR requests"/>
    <SecurityPermission permissionId="OCR_VIEW" description="View OCR requests and results"/>

    <!-- OCR Security Groups -->
    <SecurityGroup groupId="OCR_USER" description="OCR regular user group"/>
    <SecurityGroup groupId="OCR_ADMINISTRATOR" description="OCR administrator group"/>

    <!-- Group Permissions -->
    <SecurityGroupPermission groupId="OCR_USER" permissionId="OCR_CREATE" fromDate="2000-01-01 00:00:00.000"/>
    <SecurityGroupPermission groupId="OCR_USER" permissionId="OCR_VIEW" fromDate="2000-01-01 00:00:00.000"/>
    <SecurityGroupPermission groupId="OCR_ADMINISTRATOR" permissionId="OCR_ADMIN" fromDate="2000-01-01 00:00:00.000"/>
    <SecurityGroupPermission groupId="OCR_ADMINISTRATOR" permissionId="OCR_CREATE" fromDate="2000-01-01 00:00:00.000"/>
    <SecurityGroupPermission groupId="OCR_ADMINISTRATOR" permissionId="OCR_VIEW" fromDate="2000-01-01 00:00:00.000"/>

    <!-- super user -->
    <SecurityGroupPermission groupId="SUPER" permissionId="OCR_ADMIN" fromDate="2001-05-13 12:00:00.000"/>

</entity-engine-xml>
