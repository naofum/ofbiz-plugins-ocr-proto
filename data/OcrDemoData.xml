<entity-engine-xml>

    <!-- Demo Tesseract configuration -->
    <OcrEngineConfig ocrEngineConfigId="OCR_CFG_TESS_DEMO"
                     engineTypeId="TESSERACT"
                     configName="Demo Tesseract Config"
                     tessDataPath=""
                     language="eng"
                     description="Demo Tesseract configuration. Set tessDataPath to a valid path to use."/>

    <!-- Demo OpenAI compatible configuration -->
    <OcrEngineConfig ocrEngineConfigId="OCR_CFG_OPENAI_DEMO"
                     engineTypeId="OPENAI"
                     configName="Demo OpenAI Config"
                     baseUrl="https://api.openai.com/v1"
                     apiKey="REPLACE_WITH_YOUR_API_KEY"
                     modelName="gpt-4o"
                     description="Demo OpenAI compatible configuration. Replace apiKey before use."/>

    <!-- Demo mapping definition for invoice extraction -->
    <OcrMappingDefinition ocrMappingDefinitionId="OCR_MAP_INVOICE_DEMO"
                          definitionName="Invoice Extraction"
                          prompt="Extract the following fields from this invoice image: invoiceNumber, invoiceDate (yyyy-MM-dd), vendorName, totalAmount (numeric only), taxAmount (numeric only). Return the result as a JSON object."
                          outputFields="[{&quot;name&quot;:&quot;invoiceNumber&quot;,&quot;type&quot;:&quot;String&quot;},{&quot;name&quot;:&quot;invoiceDate&quot;,&quot;type&quot;:&quot;String&quot;},{&quot;name&quot;:&quot;vendorName&quot;,&quot;type&quot;:&quot;String&quot;},{&quot;name&quot;:&quot;totalAmount&quot;,&quot;type&quot;:&quot;BigDecimal&quot;},{&quot;name&quot;:&quot;taxAmount&quot;,&quot;type&quot;:&quot;BigDecimal&quot;}]"
                          description="Demo mapping definition for extracting common invoice fields."/>

</entity-engine-xml>
