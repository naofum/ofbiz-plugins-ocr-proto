<entity-engine-xml>

    <!-- OCR Request Status -->
    <StatusType statusTypeId="OCR_REQUEST_STATUS" description="OCR Request Status"/>
    <StatusItem statusId="OCRREQ_PENDING" statusTypeId="OCR_REQUEST_STATUS" statusCode="PENDING" description="Pending"/>
    <StatusItem statusId="OCRREQ_SUCCESS" statusTypeId="OCR_REQUEST_STATUS" statusCode="SUCCESS" description="Success"/>
    <StatusItem statusId="OCRREQ_ERROR" statusTypeId="OCR_REQUEST_STATUS" statusCode="ERROR" description="Error"/>

    <StatusValidChange statusId="OCRREQ_PENDING" statusIdTo="OCRREQ_SUCCESS" transitionName="Complete"/>
    <StatusValidChange statusId="OCRREQ_PENDING" statusIdTo="OCRREQ_ERROR" transitionName="Fail"/>

    <!-- OCR Engine Types -->
    <EnumerationType enumTypeId="OCR_ENGINE_TYPE" description="OCR Engine Type"/>
    <Enumeration enumId="OCR_ENGINE_TESSERACT" enumTypeId="OCR_ENGINE_TYPE" enumCode="TESSERACT" description="Tesseract OCR"/>
    <Enumeration enumId="OCR_ENGINE_OPENAI" enumTypeId="OCR_ENGINE_TYPE" enumCode="OPENAI" description="OpenAI Compatible API"/>
    <Enumeration enumId="OCR_ENGINE_BOTH" enumTypeId="OCR_ENGINE_TYPE" enumCode="BOTH" description="Both Tesseract and OpenAI"/>

</entity-engine-xml>
