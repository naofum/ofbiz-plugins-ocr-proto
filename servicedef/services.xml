<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>OCR Plugin Services</description>
    <vendor>OFBiz OCR</vendor>
    <version>1.0</version>

    <!-- OCR text extraction services -->
    <service name="ocrUploadToText" engine="java"
            location="org.apache.ofbiz.ocr.service.OcrServices" invoke="ocrUploadToText" auth="true"
            transaction-timeout="300">
        <description>Store an uploaded file as Content and extract raw text</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <attribute name="uploadedFile" type="java.nio.ByteBuffer" mode="IN" optional="false"/>
        <attribute name="_uploadedFile_fileName" type="String" mode="IN" optional="true"/>
        <attribute name="_uploadedFile_contentType" type="String" mode="IN" optional="true"/>
        <attribute name="engineTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="language" type="String" mode="IN" optional="true"/>
        <attribute name="persistResult" type="String" mode="IN" optional="true"/>
        <attribute name="contentId" type="String" mode="OUT" optional="true"/>
        <attribute name="ocrRequestId" type="String" mode="OUT" optional="true"/>
        <attribute name="rawText" type="String" mode="OUT" optional="true"/>
        <attribute name="errorMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="ocrUploadToStructuredData" engine="java"
            location="org.apache.ofbiz.ocr.service.OcrServices" invoke="ocrUploadToStructuredData" auth="true"
            transaction-timeout="300">
        <description>Store an uploaded file as Content and extract structured data</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <attribute name="uploadedFile" type="java.nio.ByteBuffer" mode="IN" optional="false"/>
        <attribute name="_uploadedFile_fileName" type="String" mode="IN" optional="true"/>
        <attribute name="_uploadedFile_contentType" type="String" mode="IN" optional="true"/>
        <attribute name="engineTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="mappingDefinitionId" type="String" mode="IN" optional="true"/>
        <attribute name="inlinePrompt" type="String" mode="IN" optional="true"/>
        <attribute name="outputFields" type="List" mode="IN" optional="true"/>
        <attribute name="persistResult" type="String" mode="IN" optional="true"/>
        <attribute name="contentId" type="String" mode="OUT" optional="true"/>
        <attribute name="ocrRequestId" type="String" mode="OUT" optional="true"/>
        <attribute name="rawText" type="String" mode="OUT" optional="true"/>
        <attribute name="structuredResult" type="Map" mode="OUT" optional="true"/>
        <attribute name="errorMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="ocrImageToText" engine="java"
            location="org.apache.ofbiz.ocr.service.OcrServices" invoke="ocrImageToText" auth="true">
        <description>Extract raw text from an image or PDF referenced by Content ID</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <attribute name="contentId" type="String" mode="IN" optional="false"/>
        <attribute name="engineTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="language" type="String" mode="IN" optional="true"/>
        <attribute name="ocrEngineConfigId" type="String" mode="IN" optional="true"/>
        <attribute name="persistResult" type="String" mode="IN" optional="true"/>
        <attribute name="ocrRequestId" type="String" mode="OUT" optional="true"/>
        <attribute name="rawText" type="String" mode="OUT" optional="true"/>
        <attribute name="errorMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="ocrBytesToText" engine="java"
            location="org.apache.ofbiz.ocr.service.OcrServices" invoke="ocrBytesToText" auth="true">
        <description>Extract raw text from a byte buffer</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <attribute name="byteBuffer" type="java.nio.ByteBuffer" mode="IN" optional="false"/>
        <attribute name="fileName" type="String" mode="IN" optional="false"/>
        <attribute name="engineTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="language" type="String" mode="IN" optional="true"/>
        <attribute name="ocrEngineConfigId" type="String" mode="IN" optional="true"/>
        <attribute name="persistResult" type="String" mode="IN" optional="true"/>
        <attribute name="ocrRequestId" type="String" mode="OUT" optional="true"/>
        <attribute name="rawText" type="String" mode="OUT" optional="true"/>
        <attribute name="errorMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- OCR structured data extraction services -->
    <service name="ocrImageToStructuredData" engine="java"
            location="org.apache.ofbiz.ocr.service.OcrServices" invoke="ocrImageToStructuredData" auth="true">
        <description>Extract structured data from an image or PDF referenced by Content ID using an AI model</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <attribute name="contentId" type="String" mode="IN" optional="false"/>
        <attribute name="engineTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="mappingDefinitionId" type="String" mode="IN" optional="true"/>
        <attribute name="inlinePrompt" type="String" mode="IN" optional="true"/>
        <attribute name="outputFields" type="List" mode="IN" optional="true"/>
        <attribute name="ocrEngineConfigId" type="String" mode="IN" optional="true"/>
        <attribute name="persistResult" type="String" mode="IN" optional="true"/>
        <attribute name="ocrRequestId" type="String" mode="OUT" optional="true"/>
        <attribute name="rawText" type="String" mode="OUT" optional="true"/>
        <attribute name="structuredResult" type="Map" mode="OUT" optional="true"/>
        <attribute name="errorMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="ocrBytesToStructuredData" engine="java"
            location="org.apache.ofbiz.ocr.service.OcrServices" invoke="ocrBytesToStructuredData" auth="true">
        <description>Extract structured data from a byte buffer using an AI model</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <attribute name="byteBuffer" type="java.nio.ByteBuffer" mode="IN" optional="false"/>
        <attribute name="fileName" type="String" mode="IN" optional="false"/>
        <attribute name="engineTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="mappingDefinitionId" type="String" mode="IN" optional="true"/>
        <attribute name="inlinePrompt" type="String" mode="IN" optional="true"/>
        <attribute name="outputFields" type="List" mode="IN" optional="true"/>
        <attribute name="ocrEngineConfigId" type="String" mode="IN" optional="true"/>
        <attribute name="persistResult" type="String" mode="IN" optional="true"/>
        <attribute name="ocrRequestId" type="String" mode="OUT" optional="true"/>
        <attribute name="rawText" type="String" mode="OUT" optional="true"/>
        <attribute name="structuredResult" type="Map" mode="OUT" optional="true"/>
        <attribute name="errorMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- Generic permission service -->
    <service name="ocrGenericPermission" engine="simple"
            location="component://ocr/minilang/OcrPermissionServices.xml" invoke="ocrGenericPermission" auth="true">
        <description>Generic OCR permission check</description>
        <attribute name="mainAction" type="String" mode="IN" optional="true"/>
        <attribute name="primaryPermission" type="String" mode="IN" optional="true"/>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- Mapping definition CRUD -->
    <service name="createOcrMappingDefinition" default-entity-name="OcrMappingDefinition" engine="entity-auto" invoke="create" auth="true">
        <description>Create an OCR mapping definition</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="OUT" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="updateOcrMappingDefinition" default-entity-name="OcrMappingDefinition" engine="entity-auto" invoke="update" auth="true">
        <description>Update an OCR mapping definition</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <!-- Engine config CRUD -->
    <service name="createOcrEngineConfig" default-entity-name="OcrEngineConfig" engine="entity-auto" invoke="create" auth="true">
        <description>Create an OCR engine configuration</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="OUT" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="updateOcrEngineConfig" default-entity-name="OcrEngineConfig" engine="entity-auto" invoke="update" auth="true">
        <description>Update an OCR engine configuration</description>
        <permission-service service-name="ocrGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

</services>
